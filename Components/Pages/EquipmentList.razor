@page "/equipment"
@using EquipmentManager.Models
@using EquipmentManager.Services
@inject SessionBackendClient Backend
@inject NavigationManager Navigation
@inject StorageSettings Storage

<PageTitle>Оборудование</PageTitle>

<h1>Оборудование</h1>

<p>Список единиц промышленного оборудования, учтённых в системе.</p>

@if (permissions.CanManageEquipment)
{
    <button type="button" class="btn btn-primary mb-3" disabled="@(busy || loading)" @onclick="AddEquipment">Добавить оборудование</button>
}
<p class="text-secondary">@(Storage.Provider == StorageProvider.InMemory ? "Учебные данные хранятся в памяти до перезапуска." : "Данные сохраняются после перезапуска приложения.")</p>

@if (deletionMessage is not null)
{
    <div class="alert alert-info" role="status">@deletionMessage</div>
}

@if (equipmentToDelete is not null)
{
    <section class="card border-danger mb-3" role="dialog" aria-labelledby="delete-equipment-title" aria-describedby="delete-equipment-description" tabindex="-1" @ref="deletionDialog">
        <div class="card-body">
            <h2 id="delete-equipment-title" class="h4">Подтверждение удаления</h2>
            <p id="delete-equipment-description">Удалить оборудование «@equipmentToDelete.Name»?</p>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-danger" disabled="@busy" @onclick="ConfirmDeletion">Удалить</button>
                <button type="button" class="btn btn-secondary" disabled="@busy" @onclick="CancelDeletion">Отмена</button>
            </div>
        </div>
    </section>
}

@if (editingEquipment is not null)
{
    <section class="card card-body mb-3" aria-labelledby="equipment-form-title">
        <h2 id="equipment-form-title" class="h4">@(editingEquipment.Id == 0 ? "Добавление оборудования" : "Редактирование оборудования")</h2>
        @if (validationErrors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                <ul class="mb-0">
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <EditForm Model="editingEquipment" OnSubmit="SaveEquipment" FormName="equipment-editor">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label for="equipment-name" class="form-label">Наименование</label>
                    <InputText id="equipment-name" class="form-control" @bind-Value="editingEquipment.Name" aria-required="true" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="equipment-number" class="form-label">Инвентарный номер</label>
                    <InputText id="equipment-number" class="form-control" @bind-Value="editingEquipment.InventoryNumber" aria-required="true" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="equipment-location" class="form-label">Место установки</label>
                    <InputText id="equipment-location" class="form-control" @bind-Value="editingEquipment.Location" aria-required="true" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="equipment-status" class="form-label">Состояние</label>
                    <InputSelect id="equipment-status" class="form-select" @bind-Value="editingEquipment.Status" aria-required="true">
                        @foreach (var status in Equipment.AllowedStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@busy">Сохранить</button>
                    <button type="button" class="btn btn-secondary" disabled="@busy" @onclick="CancelEditing">Отмена</button>
                </div>
            </div>
        </EditForm>
    </section>
}

<div class="mb-3">
    <label for="equipment-search" class="form-label">Поиск</label>
    <input id="equipment-search"
           @ref="searchInput"
           class="form-control"
           type="search"
           placeholder="Наименование или инвентарный номер"
           @bind="searchQuery"
           @bind:event="oninput" />
</div>

@{
    // Один снимок фильтра для проверки пустоты и вывода таблицы в текущем рендере.
    var filteredEquipment = FilteredEquipment;
}

@if (loadError is not null)
{
    <div class="alert alert-danger" role="alert">@loadError <button class="btn btn-outline-danger" @onclick="LoadDataAsync">Повторить</button></div>
}
else if (loading || allEquipment is null)
{
    <p><em>Загрузка...</em></p>
}
else if (allEquipment.Count == 0)
{
    <p role="status">В реестре пока нет оборудования</p>
}
else if (filteredEquipment.Count == 0)
{
    <p role="status">Оборудование не найдено</p>
}
else
{
    <div class="table-responsive border rounded bg-white" role="region" aria-label="Реестр оборудования" tabindex="0">
    <table class="table equipment-table">
        <thead>
            <tr>
                <th scope="col">Наименование</th>
                <th scope="col">Инвентарный номер</th>
                <th scope="col">Место установки</th>
                <th scope="col">Состояние</th>
                <th scope="col">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in filteredEquipment)
            {
                <tr @key="item.Id">
                    <td>@item.Name</td>
                    <td>@item.InventoryNumber</td>
                    <td>@item.Location</td>
                    <td>@item.Status</td>
                    <td>
                        @if (permissions.CanManageEquipment)
                        {
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(busy || loading)" @onclick="() => EditEquipment(item)" aria-label="@($"Редактировать {item.Name}")">Редактировать</button>
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(busy || loading)" @onclick="() => RequestDeletion(item)" aria-label="@($"Удалить {item.Name}")">Удалить</button>
                        </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private ApplicationPermissions permissions = new(false, false, false);
    private bool busy;
    private bool loading;
    private string? loadError;
    private ElementReference deletionDialog;
    private ElementReference searchInput;
    private bool focusDeletionDialog;
    private bool focusSearch;

    /// <summary>Перемещает клавиатурный фокус в подтверждение и возвращает к поиску после закрытия.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDeletionDialog)
        {
            focusDeletionDialog = false;
            await deletionDialog.FocusAsync();
        }
        else if (focusSearch)
        {
            focusSearch = false;
            await searchInput.FocusAsync();
        }
    }

    /// <summary>
    /// Запись, выбранная для подтверждения удаления.
    /// </summary>
    private Equipment? equipmentToDelete;

    /// <summary>
    /// Сообщение о результате удаления.
    /// </summary>
    private string? deletionMessage;

    /// <summary>
    /// Показывает подтверждение, не изменяя хранилище.
    /// </summary>
    private void RequestDeletion(Equipment equipment)
    {
        equipmentToDelete = equipment;
        focusDeletionDialog = true;
        deletionMessage = null;
    }

    /// <summary>
    /// Удаляет выбранную запись и обновляет таблицу с сохранением поискового запроса.
    /// </summary>
    private async Task ConfirmDeletion()
    {
        if (equipmentToDelete is null || busy)
        {
            return;
        }

        var equipment = equipmentToDelete;
        busy = true;
        try
        {
            await Backend.DeleteEquipmentAsync(equipment.Id);
            deletionMessage = $"Оборудование «{equipment.Name}» удалено.";
            if (editingEquipment?.Id == equipment.Id) { CancelEditing(); }
            CancelDeletion();
            await LoadDataAsync();
        }
        catch (BackendApiException exception) { deletionMessage = exception.Message; }
        catch (UiSignInException exception) { deletionMessage = SignInError(exception); }
        finally { busy = false; }
    }

    /// <summary>
    /// Закрывает подтверждение без изменения данных.
    /// </summary>
    private void CancelDeletion()
    {
        equipmentToDelete = null;
        focusSearch = true;
    }

    /// <summary>
    /// Независимая копия записи, изменяемая формой.
    /// </summary>
    private Equipment? editingEquipment;

    /// <summary>
    /// Ошибки последней попытки сохранения.
    /// </summary>
    private IReadOnlyList<string> validationErrors = [];

    /// <summary>
    /// Открывает форму новой записи.
    /// </summary>
    private void AddEquipment()
    {
        editingEquipment = new Equipment { Status = Equipment.AllowedStatuses[0] };
        validationErrors = [];
    }

    /// <summary>
    /// Открывает независимую копию выбранной записи.
    /// </summary>
    private void EditEquipment(Equipment equipment)
    {
        editingEquipment = new Equipment
        {
            Id = equipment.Id,
            Name = equipment.Name,
            InventoryNumber = equipment.InventoryNumber,
            Location = equipment.Location,
            Status = equipment.Status
        };
        validationErrors = [];
    }

    /// <summary>
    /// Сохраняет корректные данные и обновляет таблицу без перезагрузки.
    /// </summary>
    private async Task SaveEquipment()
    {
        if (editingEquipment is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            await Backend.SaveEquipmentAsync(editingEquipment);
            CancelEditing();
            await LoadDataAsync();
        }
        catch (BackendApiException exception) { validationErrors = exception.Errors; }
        catch (UiSignInException exception) { validationErrors = [SignInError(exception)]; }
        finally { busy = false; }
    }

    /// <summary>
    /// Закрывает форму без изменения сохранённых данных.
    /// </summary>
    private void CancelEditing()
    {
        editingEquipment = null;
        validationErrors = [];
    }

    /// <summary>
    /// Полный список оборудования без фильтрации.
    /// </summary>
    private IReadOnlyList<Equipment>? allEquipment;

    /// <summary>
    /// Текст поискового запроса.
    /// </summary>
    private string searchQuery = string.Empty;

    /// <summary>
    /// Возвращает отфильтрованный список по наименованию и инвентарному номеру.
    /// </summary>
    private IReadOnlyList<Equipment> FilteredEquipment
    {
        get
        {
            if (allEquipment is null)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(searchQuery))
            {
                return allEquipment;
            }

            string term = searchQuery.Trim();
            return allEquipment
                .Where(item =>
                    item.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase)
                    || item.InventoryNumber.Contains(term, StringComparison.CurrentCultureIgnoreCase))
                .ToList();
        }
    }

    /// <summary>
    /// Загружает оборудование при инициализации страницы.
    /// </summary>
    protected override Task OnInitializedAsync() => LoadDataAsync();

    /// <summary>Загружает данные и права через API, отличая сбой от пустого реестра.</summary>
    private async Task LoadDataAsync()
    {
        loading = true;
        loadError = null;
        try
        {
            permissions = await Backend.GetPermissionsAsync();
            allEquipment = await Backend.GetEquipmentAsync();
        }
        catch (BackendApiException exception) { loadError = exception.Message; }
        catch (UiSignInException exception) { loadError = SignInError(exception); }
        finally { loading = false; }
    }

    private string SignInError(UiSignInException exception)
    {
        if (exception.Code == "expired") { Navigation.NavigateTo("/login?error=expired&returnUrl=%2Fequipment", forceLoad: true); }
        return exception.Code == "forbidden" ? "Недостаточно прав для выполнения операции." : "Сеанс завершён либо Backend API не настроен. Войдите снова или проверьте настройки подключения.";
    }
}
