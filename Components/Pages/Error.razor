@page "/Error"
@using System.Diagnostics

<PageTitle>Ошибка — EquipmentManager</PageTitle>
<section class="card card-body" aria-labelledby="error-title">
<h1 id="error-title">Не удалось выполнить запрос</h1>
<p>Повторите попытку позже. Если ошибка повторяется, передайте администратору идентификатор запроса.</p>
@if (ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@RequestId</code></p>
}
<div><a class="btn btn-outline-primary" href="">На главную</a></div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
