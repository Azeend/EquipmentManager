@page "/faults"
@using EquipmentManager.Models
@using EquipmentManager.Services
@inject SessionBackendClient Backend
@inject NavigationManager Navigation
@inject StorageSettings Storage

<PageTitle>Неисправности — EquipmentManager</PageTitle>
<h1 class="page-title">Неисправности</h1>
<p class="text-secondary">@(Storage.Provider == StorageProvider.InMemory ? "Учебные данные хранятся в памяти до перезапуска." : "Данные сохраняются после перезапуска приложения.") Даты указаны в UTC.</p>
@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert"><ul class="mb-0">
        @foreach (var error in errors) { <li>@error</li> }
    </ul></div>
}
@if (message is not null) { <div class="alert alert-success" role="status">@message</div> }
@if (permissions.CanRegisterFault)
{
<section class="card card-body mb-3" aria-labelledby="registration-title">
    <h2 id="registration-title" class="h4">Регистрация неисправности</h2>
    @if (equipment.Count == 0) { <p>Нет оборудования. Сначала добавьте его в реестр.</p> }
    <EditForm Model="registration" OnValidSubmit="Register" FormName="fault-registration">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label for="fault-equipment" class="form-label">Оборудование</label>
                <InputSelect id="fault-equipment" class="form-select" @bind-Value="registration.EquipmentId" aria-required="true">
                    <option value="0">Выберите оборудование</option>
                    @foreach (var item in equipment) { <option value="@item.Id">@item.Name (@item.InventoryNumber)</option> }
                </InputSelect>
                <ValidationMessage For="() => registration.EquipmentId" />
            </div>
            <div class="col-12 col-md-6">
                <label for="fault-description" class="form-label">Описание неисправности</label>
                <InputTextArea id="fault-description" class="form-control" @bind-Value="registration.Description" aria-required="true" />
                <ValidationMessage For="() => registration.Description" />
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" disabled="@(equipment.Count == 0 || busy || loading)">Зарегистрировать</button>
                <button type="button" class="btn btn-secondary" disabled="@(busy || loading)" @onclick="ResetRegistration">Отмена</button>
            </div>
        </div>
    </EditForm>
</section>
}
<button type="button" class="btn btn-outline-secondary mb-3" disabled="@(busy || loading)" @onclick="Refresh">Обновить данные</button>
@if (selectedFault is not null && permissions.CanProcessFaults)
{
    <section class="card card-body mb-3" aria-labelledby="completion-title">
        <h2 id="completion-title" class="h4">Завершение заявки №@selectedFault.Id</h2>
        <p>@selectedFault.EquipmentLabel — @selectedFault.Description</p>
        <EditForm Model="completion" OnValidSubmit="Complete" FormName="fault-completion">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label for="fault-work" class="form-label">Описание выполненных работ</label>
            <InputTextArea id="fault-work" class="form-control" @bind-Value="completion.WorkDescription" aria-required="true" />
            <ValidationMessage For="() => completion.WorkDescription" />
            <label for="fault-result" class="form-label mt-2">Результат</label>
            <InputTextArea id="fault-result" class="form-control" @bind-Value="completion.Result" aria-required="true" />
            <ValidationMessage For="() => completion.Result" />
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-primary" disabled="@(busy || loading)">Завершить</button>
                <button type="button" class="btn btn-secondary" disabled="@(busy || loading)" @onclick="CancelCompletion">Отмена</button>
            </div>
        </EditForm>
    </section>
}
@if (loading) { <p class="state-panel" role="status">Загрузка...</p> }
else if (loadError is not null) { <div class="alert alert-danger" role="alert">@loadError</div> }
else if (faults.Count == 0) { <p class="state-panel" role="status">Заявок пока нет.</p> }
else
{
    <p class="table-scroll-hint text-secondary">Если таблица не помещается, прокрутите её вправо, чтобы увидеть все данные и действия. С клавиатуры: перейдите к таблице клавишей Tab и используйте стрелки.</p>
    <div class="table-responsive border rounded bg-white" role="region" aria-label="Очередь заявок" tabindex="0">
        <table class="table align-middle faults-table">
            <thead><tr><th scope="col">№</th><th scope="col">Оборудование</th><th scope="col">Описание</th><th scope="col">Статус</th><th scope="col">Автор и даты (UTC)</th><th scope="col">Работы и результат</th><th scope="col">Действия</th></tr></thead>
            <tbody>
                @foreach (var fault in faults)
                {
                    <tr @key="fault.Id" id="@($"fault-{fault.Id}")">
                        <td>@fault.Id</td><td>@fault.EquipmentLabel</td><td>@fault.Description</td><td><span class="status-badge @(fault.Status switch { "Новая" => "status-info", "В работе" => "status-warning", "Завершена" => "status-success", _ => "status-neutral" })">@fault.Status</span></td>
                        <td>@fault.Author<br />Создана: @FormatDate(fault.CreatedAt)<br />Начата: @FormatDate(fault.StartedAt)<br />Завершена: @FormatDate(fault.CompletedAt)</td>
                        <td>@fault.WorkDescription<br />@fault.Result</td>
                        <td>
                            @if (fault.Status == "Завершена") { <span>Обработка завершена</span> }
                            else if (!permissions.CanProcessFaults) { <span>Доступно специалисту</span> }
                            else if (fault.Status == "Новая")
                            { <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(busy || loading)" @onclick="() => Start(fault)">Взять в работу</button> }
                            else if (fault.Status == "В работе")
                            { <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(busy || loading)" @onclick="() => BeginCompletion(fault)">Завершить</button> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Equipment> equipment = [];
    private IReadOnlyList<Fault> faults = [];
    private IReadOnlyList<string> errors = [];
    private ApplicationPermissions permissions = new(false, false, false);
    private FaultRegistration registration = new();
    private FaultCompletion completion = new();
    private Fault? selectedFault;
    private string? message;
    private string? loadError;
    private bool loading;
    private bool busy;

    /// <summary>Загружает API-данные после установления серверного пользовательского сеанса.</summary>
    protected override Task OnInitializedAsync() => Refresh();

    /// <summary>Обновляет очередь и список оборудования, сохраняя черновики.</summary>
    private async Task Refresh()
    {
        loading = true;
        loadError = null;
        try
        {
            permissions = await Backend.GetPermissionsAsync();
            var currentEquipment = await Backend.GetEquipmentAsync();
            var currentFaults = await Backend.GetFaultsAsync();
            equipment = currentEquipment;
            faults = currentFaults;
            if (selectedFault is not null)
            {
                selectedFault = faults.FirstOrDefault(item => item.Id == selectedFault.Id) ?? selectedFault;
            }
        }
        catch (BackendApiException exception) { loadError = exception.Message; }
        catch (UiSignInException exception) { loadError = SignInError(exception); }
        finally { loading = false; }
    }

    /// <summary>Отправляет регистрацию и очищает форму только после подтверждённого успеха.</summary>
    private Task Register() => RunCommandAsync(() => Backend.RegisterFaultAsync(registration),
        "Заявка зарегистрирована со статусом «Новая».", () => registration = new());

    /// <summary>Отменяет ввод без сохранения.</summary>
    private void ResetRegistration()
    {
        registration = new();
        errors = [];
        message = null;
    }

    /// <summary>Передаёт API ожидаемую версию заявки для начала работ.</summary>
    private Task Start(Fault fault) => RunCommandAsync(() => Backend.StartFaultAsync(fault),
        $"Заявка №{fault.Id} взята в работу.");

    /// <summary>Открывает прежнюю форму завершения заявки.</summary>
    private void BeginCompletion(Fault fault)
    {
        selectedFault = fault;
        completion = new();
        errors = [];
        message = null;
    }

    /// <summary>Отправляет одну команду завершения, не создавая историю на Frontend.</summary>
    private Task Complete()
    {
        var fault = selectedFault;
        return fault is null ? Task.CompletedTask : RunCommandAsync(() => Backend.CompleteFaultAsync(fault, completion),
            $"Заявка №{fault.Id} завершена.", CancelCompletion);
    }

    /// <summary>Выполняет команду без автоматического повтора и сохраняет черновик при отказе.</summary>
    private async Task RunCommandAsync(Func<Task> command, string success, Action? afterSuccess = null)
    {
        if (busy) { return; }
        busy = true;
        message = null;
        errors = [];
        try
        {
            await command();
            afterSuccess?.Invoke();
            message = success;
        }
        catch (BackendApiException exception) { errors = exception.Errors; }
        catch (UiSignInException exception)
        {
            errors = [SignInError(exception)];
            return;
        }
        finally { busy = false; }
        await Refresh();
    }

    private string SignInError(UiSignInException exception)
    {
        if (exception.Code == "expired") { Navigation.NavigateTo("/login?error=expired&returnUrl=%2Ffaults", forceLoad: true); }
        return exception.Code == "forbidden" ? "Недостаточно прав для выполнения операции." : "Сеанс завершён либо Backend API не настроен.";
    }

    /// <summary>Отменяет завершение без изменения заявки.</summary>
    private void CancelCompletion()
    {
        selectedFault = null;
        completion = new();
    }

    /// <summary>Форматирует время в UTC.</summary>
    private static string FormatDate(DateTimeOffset? date) => date?.UtcDateTime.ToString("dd.MM.yyyy HH:mm") ?? "—";
}
