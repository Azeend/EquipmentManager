@inherits LayoutComponentBase

<div class="page">
    <a class="skip-link" href="#main-content" @onclick="FocusMainContent" @onclick:preventDefault="true">Перейти к содержимому</a>
    <aside class="sidebar" aria-label="Рабочее пространство"><NavMenu /></aside>
    <div class="workspace">
        <header class="top-row">
            <div><span class="context-label">Предприятие</span><strong>Управление оборудованием</strong></div>
            <AuthorizeView>
                <Authorized Context="session">
                    <div class="d-flex align-items-center gap-2">
                        <span class="session-status">@session.User.Identity?.Name</span>
                        <a href="account/session">Сеанс</a>
                        <form method="post" action="/account/logout" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Выйти</button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized><a href="login" data-enhance-nav="false">Войти</a></NotAuthorized>
            </AuthorizeView>
        </header>
        <main id="main-content" tabindex="-1" @ref="mainContent">
            <article class="content">@Body</article>
        </main>
    </div>
</div>

@code {
    private ElementReference mainContent;

    /// <summary>Переносит фокус к содержимому текущей страницы без перехода на главную.</summary>
    private async Task FocusMainContent() => await mainContent.FocusAsync();
}

<div id="blazor-error-ui" data-nosnippet role="alert">
    Произошла непредвиденная ошибка. Перезагрузите страницу.
    <a href="." class="reload">Перезагрузить</a>
    <button type="button" class="dismiss" aria-label="Закрыть сообщение об ошибке">×</button>
</div>
