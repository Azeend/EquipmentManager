# Шаблон для Render Environment. Заменить все <...>; приложение не читает этот файл автоматически.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000
PORT=10000
# Явный выбор учебного Render Free: доверие ingress платформы вместо проверки IP.
# В коде оба режима по умолчанию выключены; не использовать этот шаблон на публичном Kestrel.
Hosting__RenderFreeProxy=true
Hosting__RenderProxy=false
# RENDER=true предоставляет платформа; само по себе это не включает обработку заголовков.
# Для строгого режима выключить RenderFreeProxy, включить RenderProxy и подтвердить IP:
# Hosting__KnownProxies__0=<confirmed-immediate-proxy-ip>
AllowedHosts=<service-name>.onrender.com
Storage__Provider=PostgreSQL
SupabaseUiAuth__BackendBaseUrl=https://<service-name>.onrender.com/
SupabaseAuth__Enabled=true
SupabaseAuth__SettingsConfirmed=true
SupabaseAuth__Issuer=https://<project-ref>.supabase.co/auth/v1
SupabaseAuth__Audience=authenticated
SupabaseAuth__SigningAlgorithm=ES256
SupabaseUiAuth__PublishableKey=<publishable-key>
ConnectionStrings__Profiles=Host=<session-pooler-host>;Port=5432;Database=postgres;Username=equipment_app.<project-ref>;Password=<profile-role-password>;SSL Mode=VerifyFull;Maximum Pool Size=5;Timeout=15;Command Timeout=15
ConnectionStrings__EquipmentCrud=Host=<session-pooler-host>;Port=5432;Database=postgres;Username=equipment_api.<project-ref>;Password=<crud-role-password>;SSL Mode=VerifyFull;Maximum Pool Size=5;Timeout=15;Command Timeout=15
